# Flight Booking Frontend Environment Configuration
# Copy this file to .env and update the values for your environment

# API Configuration
# Production: https://backendhostinger-production.up.railway.app/api
# Local Development: http://localhost:4000/api
VITE_API_BASE_URL=https://backendhostinger-production.up.railway.app/api

# CORS Proxy (use if needed for CORS issues)
VITE_CORS_PROXY_URL=https://corsproxy.io/?

# Environment (production, development, staging)
VITE_ENV=production






